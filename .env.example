# ─────────────────────────────────────────────────────────────
# Скопируй этот файл под именем .env  (в той же папке)
# и впиши свои значения вместо примеров.
# Файл .env — секретный: не отправляй его никому.
# ─────────────────────────────────────────────────────────────

# Токен бота. Выдаёт @BotFather в Telegram после команды /newbot.
# Выглядит примерно так: 1234567890:AAEhBOweik6ad9r_QXMENQjcrGbqCr4K-AB
BOT_TOKEN=вставь_сюда_токен_бота

# Твой личный Telegram ID (просто число, например 123456789).
# Узнать его проще всего у бота @userinfobot: напиши ему что угодно —
# он ответит твоим ID. Бот будет отвечать ТОЛЬКО этому ID.
ALLOWED_USER_ID=123456789
