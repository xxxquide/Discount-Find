#!/bin/bash
# ─────────────────────────────────────────────────────────────
# Запуск бота двойным кликом (macOS).
# При первом запуске сам создаст окружение и установит библиотеки.
# ─────────────────────────────────────────────────────────────
cd "$(dirname "$0")" || exit 1

if [ ! -d ".venv" ]; then
    echo "🔧 Первый запуск: создаю окружение и ставлю библиотеки…"
    python3 -m venv .venv || { echo "❌ Не удалось создать venv. Установлен ли Python 3.11+?"; exit 1; }
    ./.venv/bin/pip install --quiet -r requirements.txt || { echo "❌ Не удалось установить библиотеки"; exit 1; }
    echo "✅ Готово."
fi

./.venv/bin/python bot.py
